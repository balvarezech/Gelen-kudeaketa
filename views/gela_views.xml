<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gelen Zerrenda-bista (Tree/List View) - 5. pantaila-argazkian oinarritua -->
    <record id="view_ikastetxeak_gela_tree" model="ir.ui.view">
        <field name="name">ikastetxeak.gela.tree</field>
        <field name="model">ikastetxeak.gela</field>
        <field name="arch" type="xml">
            <tree string="Gelen zerrenda">
                <field name="name" string="Gela izena"/>
                <field name="ikastetxe_izena" string="Ikastetxe izena"/>
                <field name="ikastetxe_id" string="Ikastetxea"/>
                <!-- 5. irudiko 'Erreserbatu' eta 'ErreserbatuWizard' botoiak -->
                <button name="action_erreserbatu" string="Erreserbatu" type="object" icon="fa-calendar-plus-o" class="btn-primary"/>
                <button name="action_erreserbatu_wizard" string="ErreserbatuWizard" type="object" icon="fa-calendar-check-o" class="btn-secondary"/>
                <field name="edukiera" string="Edukiera"/>
                <field name="kokalekua" string="Kokalekua"/>
                <field name="erabilgarri" string="Erabilgarri"/>
            </tree>
        </field>
    </record>

    <!-- Gelen Formulario-bista (Form View) - 1. eta 4. pantaila-argazkietan oinarritua -->
    <record id="view_ikastetxeak_gela_form" model="ir.ui.view">
        <field name="name">ikastetxeak.gela.form</field>
        <field name="model">ikastetxeak.gela</field>
        <field name="arch" type="xml">
            <form string="Gela">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_erreserbak" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="erreserba_kopurua" widget="statinfo" string="Erreserbak"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" string="Gela izena"/>
                            <field name="edukiera" string="Edukiera"/>
                            <field name="baliabideak" string="Eskuragarri dauden baliabideak"/>
                            <field name="kokalekua" string="Kokalekua"/>
                            <field name="ikastetxe_izena" string="Ikastetxe izena" readonly="1"/>
                        </group>
                        <group>
                            <field name="ikastetxe_id" string="Ikastetxea"/>
                            <field name="erabilgarri" string="Erabilgarri"/>
                            <field name="display_name" string="Display Name" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Erreserbak" name="erreserbak_page">
                            <field name="erreserba_ids">
                                <tree editable="bottom">
                                    <field name="name" string="Kodea" readonly="1"/>
                                    <field name="erabiltzaile_id" string="Erabiltzailea"/>
                                    <field name="hasiera_data" string="Hasiera data"/>
                                    <field name="amaiera_data" string="Amaiera data"/>
                                    <field name="state" string="Egoera" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Gelen Bilaketa-bista (Search View) -->
    <record id="view_ikastetxeak_gela_search" model="ir.ui.view">
        <field name="name">ikastetxeak.gela.search</field>
        <field name="model">ikastetxeak.gela</field>
        <field name="arch" type="xml">
            <search string="Gelak Bilatu">
                <field name="name" string="Gela izena"/>
                <field name="ikastetxe_id" string="Ikastetxea"/>
                <field name="kokalekua" string="Kokalekua"/>
                <separator/>
                <filter string="Erabilgarriak" name="filter_erabilgarri" domain="[('erabilgarri', '=', True)]"/>
                <group expand="0" string="Taldekatu (Group By)">
                    <filter string="Ikastetxea" name="group_by_ikastetxe" context="{'group_by': 'ikastetxe_id'}"/>
                    <filter string="Kokalekua" name="group_by_kokalekua" context="{'group_by': 'kokalekua'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Gelen Leiho-ekintza (Action Window) - Leihoaren izena: 'ikastetxekoGelak window' -->
    <record id="action_ikastetxeko_gelak_window" model="ir.actions.act_window">
        <field name="name">ikastetxekoGelak window</field>
        <field name="res_model">ikastetxeak.gela</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ikastetxeak_gela_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sortu zure lehen gela!
            </p>
        </field>
    </record>
</odoo>
